---
import { withBase } from "../../utils/withBase";
---

<section class="safety section section--soft" id="safety">
  <div class="container">
    <div class="safety-header reveal">
      <h2 class="section-title-center">Verified people. Clear rules.</h2>
      <p class="safety-intro">
        Every account is CNIC-checked and manually reviewed. Contacts stay private until both sides have paid. Non-dutiable items only — see the Terms for the full prohibited list.
      </p>
    </div>

    <div class="safety-grid">
      <div class="safety-card reveal">
        <h3 class="safety-role">Sender</h3>
        <ul class="safety-list">
          <li>Declare contents and weight accurately</li>
          <li>Send only non-dutiable, non-prohibited items</li>
          <li>Upload required photos and pack for air travel</li>
          <li>Accept that customs may detain or confiscate</li>
        </ul>
      </div>

      <div class="safety-card reveal" style="transition-delay: 80ms">
        <h3 class="safety-role">Passenger</h3>
        <ul class="safety-list">
          <li>Inspect before accepting; refuse if contents don’t match</li>
          <li>Must refuse if a Prohibited Item is suspected</li>
          <li>Carry in your own baggage; declare when required</li>
          <li>Deliver only to the named Receiver after CNIC check</li>
        </ul>
      </div>

      <div class="safety-card reveal" style="transition-delay: 160ms">
        <h3 class="safety-role">Receiver</h3>
        <ul class="safety-list">
          <li>Must match the name and CNIC on the Booking</li>
          <li>Original CNIC required at handover — no other ID</li>
          <li>Delivery photo includes Receiver CNIC with the Parcel</li>
        </ul>
      </div>
    </div>

    <div class="prohibited-link reveal">
      <p>Full rules live in the Terms. Start with what you cannot send.</p>
      <div class="prohibited-actions">
        <a href={withBase("prohibited-items")} class="btn btn--secondary">Prohibited items</a>
        <a href={withBase("customs-and-liability")} class="btn btn--secondary">Customs &amp; liability</a>
        <a href={withBase("terms")} class="btn btn--secondary">Terms and Conditions</a>
      </div>
    </div>
  </div>
</section>

<style>
  .safety-header {
    text-align: center;
    max-width: var(--container-text);
    margin-inline: auto;
    margin-bottom: var(--space-10);
  }

  .section-title-center {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }

  .safety-intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .safety-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .safety-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .safety-card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--border-soft);
  }

  .safety-role {
    font-size: var(--text-card);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-4);
    color: var(--brand-primary);
  }

  .safety-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .safety-list li {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding-left: var(--space-5);
    position: relative;
  }

  .safety-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-primary);
    opacity: 0.5;
  }

  .prohibited-link {
    text-align: center;
    margin-top: var(--space-10);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .prohibited-link p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .prohibited-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
</style>
