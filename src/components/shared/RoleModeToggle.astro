---
---

<section class="roles section section--white" id="sender">
  <!-- #carry lands here too — same section covers both modes -->
  <div id="carry" aria-hidden="true"></div>
  <div class="container">
    <div class="roles-inner">
      <div class="roles-text reveal">
        <h2 class="section-title">Send today. Carry next month.</h2>
        <p class="section-subtitle">One verified account. Post a parcel or list spare baggage on a flight you already have.</p>

        <!-- Toggle -->
        <div class="role-toggle" role="radiogroup" aria-label="Choose role view">
          <button
            class="toggle-option is-active"
            role="radio"
            aria-checked="true"
            data-role="sender"
            id="toggle-sender"
          >
            Sending
          </button>
          <button
            class="toggle-option"
            role="radio"
            aria-checked="false"
            data-role="passenger"
            id="toggle-passenger"
          >
            Carrying
          </button>
          <div class="toggle-indicator" id="toggle-indicator" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Phone mockup -->
      <div class="roles-phone reveal" style="transition-delay: 150ms">
        <div class="phone-frame">
          <div class="phone-notch" aria-hidden="true"></div>

          <!-- Sender screen -->
          <div class="phone-screen is-active" id="screen-sender">
            <div class="screen-header">
              <span class="screen-mode-badge sender-badge">Sender mode</span>
            </div>
            <div class="screen-card">
              <div class="screen-card-header">
                <span class="screen-card-label">Active parcel</span>
                <span class="screen-card-status status--ok">Matching</span>
              </div>
              <p class="screen-card-route">Dubai → Rawalpindi</p>
              <p class="screen-card-detail">7.5 kg · Clothes, Confectionery</p>
              <p class="screen-card-detail">Collection: 14–19 Sep</p>
            </div>
            <div class="screen-card screen-card--outline">
              <span class="screen-card-label">Tracking</span>
              <div class="screen-tracking-id">KHP-7F42-9210</div>
            </div>
            <div class="screen-actions">
              <div class="screen-action-btn">View offers</div>
              <div class="screen-action-btn screen-action-btn--outline">Edit parcel</div>
            </div>
          </div>

          <!-- Passenger screen -->
          <div class="phone-screen" id="screen-passenger">
            <div class="screen-header">
              <span class="screen-mode-badge passenger-badge">Passenger mode</span>
            </div>
            <div class="screen-card">
              <div class="screen-card-header">
                <span class="screen-card-label">Active trip</span>
                <span class="screen-card-status status--ok">Listed</span>
              </div>
              <p class="screen-card-route">Dubai → Rawalpindi</p>
              <p class="screen-card-detail">Flight: 17 Sep</p>
              <p class="screen-card-detail">12 kg spare capacity</p>
            </div>
            <div class="screen-card screen-card--outline">
              <div class="screen-card-header">
                <span class="screen-card-label">Matching offers</span>
                <span class="screen-card-count">3</span>
              </div>
              <p class="screen-card-detail">Newest: 7.5 kg · PKR 6,750</p>
            </div>
            <div class="screen-card screen-card--earnings">
              <span class="screen-card-label">Potential earnings</span>
              <div class="screen-earnings-amount">PKR 6,075</div>
              <p class="screen-card-detail">Based on current offers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .roles-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .roles-inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }

  .section-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-8);
  }

  /* ── Toggle ────────────────────────────────────────── */
  .role-toggle {
    position: relative;
    display: inline-flex;
    background: var(--surface-soft);
    border-radius: var(--radius-md);
    padding: 4px;
    border: 1px solid var(--border-soft);
  }

  .toggle-option {
    position: relative;
    z-index: 2;
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease-out);
    min-width: 120px;
  }

  .toggle-option.is-active {
    color: var(--brand-primary);
  }

  .toggle-indicator {
    position: absolute;
    top: 4px;
    left: 4px;
    width: calc(50% - 4px);
    height: calc(100% - 8px);
    background: var(--surface);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-normal) var(--ease-out);
    z-index: 1;
  }

  .toggle-indicator.is-right {
    transform: translateX(100%);
  }

  /* ── Phone Frame ───────────────────────────────────── */
  .roles-phone {
    display: flex;
    justify-content: center;
  }

  .phone-frame {
    position: relative;
    width: var(--phone-width);
    height: 580px;
    background: var(--surface);
    border-radius: 40px;
    border: 1px solid var(--border-medium);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    padding: var(--space-6) var(--space-4);
    padding-top: 52px;
  }

  .phone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 28px;
    background: var(--text-primary);
    border-radius: 20px;
  }

  /* ── Phone Screens ─────────────────────────────────── */
  .phone-screen {
    position: absolute;
    inset: 52px var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    opacity: 0;
    transform: translateX(20px);
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
    pointer-events: none;
  }

  .phone-screen.is-active {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .screen-header {
    display: flex;
    align-items: center;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-soft);
    margin-bottom: var(--space-2);
  }

  .screen-mode-badge {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .sender-badge {
    background: var(--ink-50);
    color: var(--brand-primary);
  }

  .passenger-badge {
    background: var(--ok-soft);
    color: var(--ok);
  }

  /* ── Screen Cards ──────────────────────────────────── */
  .screen-card {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
    border: 1px solid var(--border-soft);
  }

  .screen-card--outline {
    background: transparent;
  }

  .screen-card--earnings {
    background: linear-gradient(135deg, var(--ok-soft), transparent);
  }

  .screen-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .screen-card-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .screen-card-status {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
  }

  .status--ok {
    background: var(--ok-soft);
    color: var(--ok);
  }

  .screen-card-route {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .screen-card-detail {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .screen-card-count {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    background: var(--brand-primary);
    color: white;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .screen-tracking-id {
    font-family: monospace;
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
    margin-top: var(--space-2);
  }

  .screen-earnings-amount {
    font-size: 1.25rem;
    font-weight: var(--weight-bold);
    color: var(--ok);
    margin: var(--space-2) 0;
  }

  .screen-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }

  .screen-action-btn {
    padding: var(--space-3);
    text-align: center;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-md);
    background: var(--brand-primary);
    color: white;
  }

  .screen-action-btn--outline {
    background: transparent;
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
  }
</style>

<script>
  const toggleSender = document.getElementById('toggle-sender')!;
  const togglePassenger = document.getElementById('toggle-passenger')!;
  const indicator = document.getElementById('toggle-indicator')!;
  const screenSender = document.getElementById('screen-sender')!;
  const screenPassenger = document.getElementById('screen-passenger')!;

  function setRole(role: 'sender' | 'passenger') {
    const isSender = role === 'sender';

    toggleSender.classList.toggle('is-active', isSender);
    togglePassenger.classList.toggle('is-active', !isSender);
    toggleSender.setAttribute('aria-checked', String(isSender));
    togglePassenger.setAttribute('aria-checked', String(!isSender));

    indicator.classList.toggle('is-right', !isSender);

    // Transition screens
    if (isSender) {
      screenPassenger.classList.remove('is-active');
      screenPassenger.style.transform = 'translateX(20px)';
      setTimeout(() => {
        screenSender.classList.add('is-active');
      }, 100);
    } else {
      screenSender.classList.remove('is-active');
      screenSender.style.transform = 'translateX(-20px)';
      setTimeout(() => {
        screenPassenger.classList.add('is-active');
      }, 100);
    }
  }

  toggleSender.addEventListener('click', () => setRole('sender'));
  togglePassenger.addEventListener('click', () => setRole('passenger'));

  // Keyboard support
  [toggleSender, togglePassenger].forEach((btn) => {
    btn.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        setRole('sender');
        toggleSender.focus();
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        setRole('passenger');
        togglePassenger.focus();
      }
    });
  });
</script>
