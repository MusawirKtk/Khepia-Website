---
---

<section class="support section section--white" id="support">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title-center">Need help? Reach us directly.</h2>
      <p class="section-subtitle">Email or WhatsApp — same support team.</p>
    </div>

    <div class="support-grid">
      <div class="support-card reveal">
        <div class="support-icon support-icon--wa">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
        </div>
        <h3 class="support-card-title">WhatsApp</h3>
        <p class="support-card-desc">Chat with support.</p>
        <a href="https://wa.me/0000000000" class="btn btn--primary" id="whatsapp-support-btn">Message support</a>
      </div>

      <div class="support-card reveal" style="transition-delay: 100ms">
        <div class="support-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h3 class="support-card-title">Email</h3>
        <p class="support-card-desc">khepia.pk@gmail.com</p>
        <a href="mailto:khepia.pk@gmail.com" class="btn btn--primary" id="email-support-btn">Email support</a>
      </div>
    </div>

    <div class="support-legal reveal">
      <p class="support-legal-lead">Before you register, read:</p>
      <div class="support-legal-links">
        <a href="/terms">Terms and Conditions</a>
        <span class="support-legal-sep" aria-hidden="true">·</span>
        <a href="/privacy">Privacy Policy</a>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    max-width: var(--container-text);
    margin-inline: auto;
    margin-bottom: var(--space-10);
  }

  .section-title-center {
    font-size: var(--text-h2);
    margin-bottom: var(--space-3);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .support-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 560px;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .support-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .support-card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface-soft);
    border: 1px solid var(--border-soft);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .support-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: var(--ink-50);
    color: var(--brand-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .support-icon--wa {
    background: rgba(31, 168, 85, 0.1);
    color: var(--wa);
  }

  .support-card-title {
    font-size: var(--text-card);
    font-weight: var(--weight-bold);
  }

  .support-card-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .support-card .btn {
    margin-top: auto;
  }

  .support-legal {
    text-align: center;
    margin-top: var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .support-legal-lead {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  .support-legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3) var(--space-4);
    font-size: var(--text-body);
  }

  .support-legal-links a {
    color: var(--brand-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .support-legal-sep {
    color: var(--text-muted);
  }
</style>
