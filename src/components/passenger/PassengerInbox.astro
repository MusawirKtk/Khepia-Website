---
import { demoParcel, demoTrip, demoMoney, formatPKR } from '../../data/demo';
---

<section class="passenger section section--white" id="carry">
  <div class="container">
    <div class="passenger-inner">
      <div class="passenger-text reveal">
        <span class="section-label">Passenger journey</span>
        <h2 class="section-title">Travellers see parcels that fit their trip.</h2>
        <p class="section-subtitle">Review offers, negotiate rates, and manage your spare baggage capacity.</p>
        <p class="passenger-training-link">
          Flying soon? <a href="#training" class="inline-link">Watch the 3:02 Passenger Training.</a>
        </p>
      </div>

      <div class="passenger-demo reveal" style="transition-delay: 150ms">
        <!-- Offer inbox mockup -->
        <div class="inbox-phone">
          <div class="inbox-header">
            <span class="inbox-title">Matching offers</span>
            <span class="inbox-count">3 offers</span>
          </div>

          <!-- Capacity meter -->
          <div class="capacity-meter">
            <div class="capacity-bar">
              <div class="capacity-fill" style={`width: ${((demoTrip.spareKg - demoTrip.remainingAfterMatch) / demoTrip.spareKg) * 100}%`}></div>
            </div>
            <div class="capacity-labels">
              <span>{demoTrip.spareKg} kg available</span>
              <span>Accepting {demoParcel.weightKg} kg → {demoTrip.remainingAfterMatch} kg left</span>
            </div>
          </div>

          <!-- Offer card -->
          <div class="offer-card">
            <div class="offer-route">
              <span class="offer-city">{demoParcel.origin}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              <span class="offer-city">{demoParcel.destination}</span>
            </div>
            <div class="offer-details">
              <span>{demoParcel.weightKg} kg</span>
              <span class="offer-dot">·</span>
              <span>{demoParcel.items.join(", ")}</span>
            </div>
            <div class="offer-price">{formatPKR(demoParcel.carryingAmount)}</div>
            <div class="offer-collect">Collect {demoParcel.collectionWindow}</div>
            <div class="offer-actions">
              <button class="offer-btn offer-btn--accept">Accept</button>
              <button class="offer-btn offer-btn--counter">Counter-offer</button>
              <button class="offer-btn offer-btn--pass">Pass</button>
            </div>
          </div>

          <!-- Counter-offer preview -->
          <div class="counter-preview">
            <div class="counter-header">Counter-offer</div>
            <div class="counter-row">
              <span class="counter-label">Original rate</span>
              <span class="counter-value">{formatPKR(demoParcel.ratePerKg)}/kg</span>
            </div>
            <div class="counter-row counter-row--highlight">
              <span class="counter-label">Your rate</span>
              <span class="counter-value">{formatPKR(1050)}/kg</span>
            </div>
            <div class="counter-row">
              <span class="counter-label">{demoParcel.weightKg} kg × {formatPKR(1050)}</span>
              <span class="counter-value counter-value--bold">{formatPKR(7875)}</span>
            </div>
            <div class="counter-divider"></div>
            <div class="counter-row">
              <span class="counter-label">Khepia commission</span>
              <span class="counter-value">– {formatPKR(788)}</span>
            </div>
            <div class="counter-row counter-row--earn">
              <span class="counter-label">Your net earning</span>
              <span class="counter-value counter-value--bold">{formatPKR(7087)}</span>
            </div>
            <p class="counter-note">Example values only</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .passenger-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .passenger-inner {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-16);
    }
  }

  .section-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--brand-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .passenger-training-link {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .inline-link {
    color: var(--brand-primary);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Inbox Phone ───────────────────────────────────── */
  .inbox-phone {
    background: var(--surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    max-width: 400px;
    margin-inline: auto;
  }

  .inbox-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-soft);
  }

  .inbox-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .inbox-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* ── Capacity Meter ────────────────────────────────── */
  .capacity-meter {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-soft);
  }

  .capacity-bar {
    height: 8px;
    border-radius: 4px;
    background: var(--surface-soft);
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .capacity-fill {
    height: 100%;
    border-radius: 4px;
    background: var(--brand-primary);
    transition: width var(--duration-slow) var(--ease-out);
  }

  .capacity-labels {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* ── Offer Card ─────────────────────────────────────── */
  .offer-card {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-soft);
  }

  .offer-route {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .offer-city {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .offer-details {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .offer-dot {
    margin: 0 var(--space-1);
  }

  .offer-price {
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .offer-collect {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .offer-actions {
    display: flex;
    gap: var(--space-2);
  }

  .offer-btn {
    flex: 1;
    padding: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .offer-btn--accept {
    background: var(--brand-primary);
    color: white;
  }

  .offer-btn--counter {
    background: var(--surface-soft);
    color: var(--text-primary);
    border: 1px solid var(--border-soft);
  }

  .offer-btn--pass {
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border-soft);
  }

  /* ── Counter Preview ────────────────────────────────── */
  .counter-preview {
    padding: var(--space-4) var(--space-5);
  }

  .counter-header {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
  }

  .counter-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-1) 0;
  }

  .counter-row--highlight {
    background: var(--ink-50);
    margin-inline: calc(-1 * var(--space-2));
    padding-inline: var(--space-2);
    border-radius: var(--radius-sm);
  }

  .counter-row--earn {
    margin-top: var(--space-1);
  }

  .counter-label {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .counter-value {
    font-size: var(--text-xs);
    color: var(--text-primary);
  }

  .counter-value--bold {
    font-weight: var(--weight-bold);
  }

  .counter-divider {
    height: 1px;
    background: var(--border-soft);
    margin: var(--space-2) 0;
  }

  .counter-note {
    font-size: 10px;
    color: var(--text-muted);
    text-align: center;
    margin-top: var(--space-3);
    font-style: italic;
  }
</style>
