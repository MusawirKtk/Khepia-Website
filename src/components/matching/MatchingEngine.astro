---
import { demoParcel, demoTrip, matchConditions } from '../../data/demo';
---

<section class="matching section section--soft" id="matching">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Matching</span>
      <h2 class="section-title">How does Khepia decide it's a match?</h2>
      <p class="section-subtitle">Four conditions must pass before a parcel and trip are compatible.</p>
    </div>

    <div class="matching-demo reveal">
      <!-- Sender card -->
      <div class="match-card match-card--sender">
        <div class="match-card-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M2 10h20"/></svg>
          Parcel
        </div>
        <div class="match-card-route">
          <span class="match-city">{demoParcel.origin}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          <span class="match-city">{demoParcel.destination}</span>
        </div>
        <div class="match-card-meta">
          <span>{demoParcel.weightKg} kg</span>
          <span>Pickup {demoParcel.collectionWindow}</span>
        </div>
      </div>

      <!-- Conditions -->
      <div class="match-conditions">
        {matchConditions.map((condition) => (
          <div class="condition-row">
            <span class="condition-check">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="condition-label">{condition.label}</span>
          </div>
        ))}
        <div class="match-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>
          Match found
        </div>
      </div>

      <!-- Passenger card -->
      <div class="match-card match-card--passenger">
        <div class="match-card-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
          Flight
        </div>
        <div class="match-card-route">
          <span class="match-city">{demoTrip.origin}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          <span class="match-city">{demoTrip.destination}</span>
        </div>
        <div class="match-card-meta">
          <span>Flight {demoTrip.flightDate}</span>
          <span>{demoTrip.spareKg} kg spare</span>
        </div>
      </div>
    </div>

    <!-- Privacy note -->
    <div class="privacy-note reveal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <p>Contact details stay private until both sides commit.</p>
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    max-width: var(--container-text);
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  .section-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--brand-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  /* ── Demo Layout ────────────────────────────────────── */
  .matching-demo {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 900px;
    margin-inline: auto;
    align-items: center;
  }

  @media (min-width: 768px) {
    .matching-demo {
      grid-template-columns: 1fr auto 1fr;
      gap: var(--space-8);
    }
  }

  /* ── Match Cards ────────────────────────────────────── */
  .match-card {
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-md);
  }

  .match-card-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-3);
  }

  .match-card-route {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .match-city {
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .match-card-route svg {
    color: var(--text-muted);
  }

  .match-card-meta {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-label);
    color: var(--text-secondary);
  }

  /* ── Conditions ─────────────────────────────────────── */
  .match-conditions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-sm);
  }

  .condition-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .condition-check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--ok-soft);
    color: var(--ok);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .condition-label {
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: var(--weight-medium);
  }

  .match-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--ok-soft);
    color: var(--ok);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  /* ── Privacy Note ───────────────────────────────────── */
  .privacy-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-10);
    padding: var(--space-4) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    max-width: 520px;
    margin-inline: auto;
  }

  .privacy-note svg {
    color: var(--brand-primary);
    flex-shrink: 0;
  }

  .privacy-note p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: var(--weight-medium);
  }
</style>
