---
import { demoParcel, formatPKR, senderChecklist, senderItemCategories } from '../../data/demo';
---

<section class="sender section section--white" id="sender">
  <div class="container">
    <div class="sender-header reveal">
      <span class="section-label">Sender journey</span>
      <h2 class="section-title">See how a sender creates a parcel.</h2>
      <p class="section-subtitle">Six steps. Every detail recorded before the parcel leaves your hands.</p>
      <p class="sender-training-link">
        New sender? <a href="#training" class="inline-link">Watch the 2:14 Sender Training.</a>
      </p>
    </div>

    <div class="sender-steps">
      <!-- Step 1: Items -->
      <div class="sender-step reveal">
        <div class="step-content">
          <span class="step-badge">Step 1</span>
          <h3 class="step-title">Tell us what's inside.</h3>
          <p class="step-desc">Select the categories that describe your parcel contents.</p>
          <div class="item-chips">
            {senderItemCategories.map((item) => (
              <span class="item-chip">{item}</span>
            ))}
          </div>
          <p class="step-rule">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Non-dutiable / permitted items only.
          </p>
        </div>
        <div class="step-visual">
          <div class="mini-phone">
            <div class="mini-phone-header">Items</div>
            <div class="mini-phone-content">
              {senderItemCategories.map((item, i) => (
                <div class={`mini-chip ${i < 2 ? 'mini-chip--selected' : ''}`}>
                  {i < 2 && <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>}
                  {item}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: Readiness -->
      <div class="sender-step reveal">
        <div class="step-content">
          <span class="step-badge">Step 2</span>
          <h3 class="step-title">Make sure the parcel is ready.</h3>
          <p class="step-desc">Each requirement is checked before you can proceed.</p>
          <ul class="checklist">
            {senderChecklist.map((item) => (
              <li class="checklist-item">
                <span class="check-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="step-visual">
          <div class="mini-phone">
            <div class="mini-phone-header">Readiness</div>
            <div class="mini-phone-content checklist-visual">
              {senderChecklist.map((item, i) => (
                <div class={`check-row ${i < 3 ? 'check-row--done' : ''}`}>
                  <div class={`check-box ${i < 3 ? 'check-box--done' : ''}`}>
                    {i < 3 && <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>}
                  </div>
                  <span class="check-label-mini">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3: Route and dates -->
      <div class="sender-step reveal">
        <div class="step-content">
          <span class="step-badge">Step 3</span>
          <h3 class="step-title">Tell us where it needs to go.</h3>
          <p class="step-desc">Set the origin, destination, and your collection and delivery windows.</p>
        </div>
        <div class="step-visual">
          <div class="mini-phone">
            <div class="mini-phone-header">Route</div>
            <div class="mini-phone-content">
              <div class="route-field">
                <span class="route-label">Origin</span>
                <span class="route-value">{demoParcel.origin}</span>
              </div>
              <div class="route-field">
                <span class="route-label">Destination</span>
                <span class="route-value">{demoParcel.destination}</span>
              </div>
              <div class="route-field">
                <span class="route-label">Collection window</span>
                <span class="route-value">{demoParcel.collectionWindow}</span>
              </div>
              <div class="route-field">
                <span class="route-label">Delivery target</span>
                <span class="route-value">{demoParcel.deliveryTarget}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 4: Parcel evidence -->
      <div class="sender-step reveal">
        <div class="step-content">
          <span class="step-badge">Step 4</span>
          <h3 class="step-title">Create a record of exactly what you're sending.</h3>
          <p class="step-desc">These photos create a record of the parcel before it leaves the sender.</p>
        </div>
        <div class="step-visual">
          <div class="mini-phone">
            <div class="mini-phone-header">Evidence</div>
            <div class="mini-phone-content photo-grid">
              <div class="photo-slot">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <span>Unpacked</span>
              </div>
              <div class="photo-slot photo-slot--filled">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Packed</span>
              </div>
              <div class="photo-slot">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <span>Label</span>
              </div>
              <div class="photo-slot">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <span>Weight</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 5: Recipient -->
      <div class="sender-step reveal">
        <div class="step-content">
          <span class="step-badge">Step 5</span>
          <h3 class="step-title">Who's receiving it?</h3>
          <p class="step-desc">Recipient identity is checked at handover.</p>
        </div>
        <div class="step-visual">
          <div class="mini-phone">
            <div class="mini-phone-header">Recipient</div>
            <div class="mini-phone-content">
              <div class="route-field">
                <span class="route-label">Name</span>
                <span class="route-value">Fatima K.</span>
              </div>
              <div class="route-field">
                <span class="route-label">Phone</span>
                <span class="route-value">+92 •••• ••••12</span>
              </div>
              <div class="route-field">
                <span class="route-label">CNIC</span>
                <span class="route-value">•••••-•••••••-•</span>
              </div>
              <div class="route-field">
                <span class="route-label">Declared value</span>
                <span class="route-value route-value--highlight">{formatPKR(demoParcel.declaredValue)}</span>
              </div>
              <div class="route-field">
                <span class="route-label">Weight</span>
                <span class="route-value">{demoParcel.weightKg} kg</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 6: Price and post -->
      <div class="sender-step reveal">
        <div class="step-content">
          <span class="step-badge">Step 6</span>
          <h3 class="step-title">Choose what you're willing to pay.</h3>
          <p class="step-desc">Set your rate per kilogram. Travellers can accept or counter-offer.</p>
        </div>
        <div class="step-visual">
          <div class="mini-phone">
            <div class="mini-phone-header">Price & post</div>
            <div class="mini-phone-content">
              <div class="price-calc">
                <div class="price-row">
                  <span>{demoParcel.weightKg} kg × {formatPKR(demoParcel.ratePerKg)}/kg</span>
                </div>
                <div class="price-total">{formatPKR(demoParcel.carryingAmount)}</div>
                <p class="price-note">Example amount</p>
              </div>
              <div class="post-btn-demo">Post parcel</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sender-header {
    text-align: center;
    max-width: var(--container-text);
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  .section-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--brand-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .sender-training-link {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .inline-link {
    color: var(--brand-primary);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Steps ─────────────────────────────────────────── */
  .sender-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  .sender-step {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 768px) {
    .sender-step {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
    }

    .sender-step:nth-child(even) {
      direction: rtl;
    }

    .sender-step:nth-child(even) > * {
      direction: ltr;
    }
  }

  .step-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--brand-primary);
    background: var(--ink-50);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .step-title {
    font-size: var(--text-h3);
    margin-bottom: var(--space-3);
  }

  .step-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  /* ── Item Chips ────────────────────────────────────── */
  .item-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .item-chip {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--surface-tint);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    border: 1px solid var(--border-soft);
  }

  .step-rule {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-label);
    color: var(--warn);
    font-weight: var(--weight-medium);
  }

  /* ── Checklist ─────────────────────────────────────── */
  .checklist {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .checklist-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .check-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ok-soft);
    color: var(--ok);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ── Mini Phone ────────────────────────────────────── */
  .mini-phone {
    background: var(--surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    max-width: 320px;
    margin-inline: auto;
  }

  .mini-phone-header {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mini-phone-content {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mini-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    background: var(--surface-soft);
    color: var(--text-secondary);
    border: 1px solid var(--border-soft);
  }

  .mini-chip--selected {
    background: var(--ink-50);
    color: var(--brand-primary);
    border-color: var(--brand-primary);
  }

  /* Route fields */
  .route-field {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-soft);
  }

  .route-field:last-child {
    border-bottom: none;
  }

  .route-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .route-value {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
  }

  .route-value--highlight {
    color: var(--brand-primary);
  }

  /* Checklist visual */
  .check-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .check-box {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .check-box--done {
    background: var(--ok);
    border-color: var(--ok);
  }

  .check-label-mini {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .check-row--done .check-label-mini {
    color: var(--text-primary);
  }

  /* Photo grid */
  .photo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .photo-slot {
    aspect-ratio: 1;
    border: 2px dashed var(--border-medium);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .photo-slot--filled {
    border-style: solid;
    border-color: var(--ok);
    background: var(--ok-soft);
    color: var(--ok);
  }

  /* Price calc */
  .price-calc {
    text-align: center;
    padding: var(--space-4);
    background: var(--surface-soft);
    border-radius: var(--radius-md);
  }

  .price-row {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .price-total {
    font-size: 1.5rem;
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .price-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-2);
    font-style: italic;
  }

  .post-btn-demo {
    margin-top: var(--space-3);
    padding: var(--space-3);
    text-align: center;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-md);
    background: var(--brand-primary);
    color: white;
  }
</style>
