---
import { trainingVideos } from '../../data/training';
---

<section class="training section section--tint" id="training">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title">Know exactly how Khepia works before you use it.</h2>
      <p class="section-subtitle">Sending and carrying involve different responsibilities. Watch the training for the role you plan to use.</p>
    </div>

    <div class="training-grid">
      {trainingVideos.map((video, index) => (
        <div class={`training-card reveal ${video.id === 'overview' ? 'training-card--featured' : ''}`} style={`transition-delay: ${index * 100}ms`}>
          <!-- Poster / player area -->
          <div class="training-poster">
            <div class="poster-placeholder">
              <div class="poster-icon">
                {video.id === 'overview' && (
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/></svg>
                )}
                {video.id === 'sender' && (
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M2 10h20"/></svg>
                )}
                {video.id === 'passenger' && (
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
                )}
              </div>
            </div>
            <button class="play-btn" aria-label={`Play ${video.title}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21"/></svg>
            </button>
            <span class="poster-duration">{video.duration}</span>
          </div>

          <!-- Card content -->
          <div class="training-content">
            <span class="training-label">{video.subtitle}</span>
            <h3 class="training-title">{video.title}</h3>
            <p class="training-desc">{video.description}</p>

            <!-- Chapters -->
            <details class="chapters-accordion">
              <summary class="chapters-toggle">
                <span>Chapters</span>
                <svg class="chapters-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <ol class="chapters-list">
                {video.chapters.map((chapter) => (
                  <li class="chapter-item">
                    <span class="chapter-time">{chapter.time}</span>
                    <span class="chapter-label">{chapter.label}</span>
                  </li>
                ))}
              </ol>
            </details>

            <!-- CTAs -->
            <div class="training-ctas">
              <button class="btn btn--primary">{video.ctaLabel}</button>
              {video.secondaryCta && (
                <a href={video.secondaryCta.href} class="btn btn--secondary">
                  {video.secondaryCta.label}
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    max-width: var(--container-text);
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .training-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .training-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  /* ── Card ──────────────────────────────────────────── */
  .training-card {
    background: var(--surface);
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border-soft);
    display: flex;
    flex-direction: column;
    transition: box-shadow var(--duration-normal) var(--ease-out);
  }

  .training-card:hover {
    box-shadow: var(--shadow-lg);
  }

  /* ── Poster ────────────────────────────────────────── */
  .training-poster {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .poster-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .poster-icon {
    color: rgba(255, 255, 255, 0.2);
  }

  .play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    color: white;
    opacity: 0.8;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .play-btn:hover {
    opacity: 1;
  }

  .play-btn svg {
    width: 40px;
    height: 40px;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
  }

  .poster-duration {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: white;
    background: rgba(0, 0, 0, 0.6);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  /* ── Content ───────────────────────────────────────── */
  .training-content {
    padding: var(--space-5) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .training-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--brand-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .training-title {
    font-size: var(--text-card);
    font-weight: var(--weight-bold);
    margin-bottom: 0;
  }

  .training-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
  }

  /* ── Chapters Accordion ────────────────────────────── */
  .chapters-accordion {
    margin-top: var(--space-2);
  }

  .chapters-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) 0;
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
    cursor: pointer;
    list-style: none;
  }

  .chapters-toggle::-webkit-details-marker {
    display: none;
  }

  .chapters-chevron {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  details[open] .chapters-chevron {
    transform: rotate(180deg);
  }

  .chapters-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-bottom: var(--space-2);
  }

  .chapter-item {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-1) 0;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .chapter-time {
    color: var(--text-muted);
    font-family: monospace;
    min-width: 36px;
    flex-shrink: 0;
  }

  .chapter-label {
    color: var(--text-secondary);
  }

  /* ── CTAs ───────────────────────────────────────────── */
  .training-ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .training-ctas .btn {
    font-size: var(--text-label);
    min-height: 40px;
    padding: var(--space-2) var(--space-4);
  }
</style>
