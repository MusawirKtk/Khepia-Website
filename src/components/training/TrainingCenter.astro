---
import { trainingVideo } from '../../data/training';
import { withBase } from '../../utils/withBase';

const video = trainingVideo;
const posterUrl = `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`;
const embedSrc = `https://www.youtube-nocookie.com/embed/${video.youtubeId}?autoplay=1&rel=0&modestbranding=1`;
const secondaryHref = video.secondaryCta
  ? withBase(video.secondaryCta.href)
  : undefined;
---

<section class="training section section--tint" id="training">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title">Know how Khepia works before you use it.</h2>
      <p class="section-subtitle">One short training covers sending and carrying. Confirm you've watched it in the app before you post.</p>
    </div>

    <div class="training-card reveal">
      <div
        class="training-player"
        id="training-player"
        data-embed-src={embedSrc}
      >
        <img
          class="training-poster-img"
          src={posterUrl}
          alt=""
          width="480"
          height="360"
          loading="lazy"
          decoding="async"
        />
        <button
          type="button"
          class="play-btn"
          id="training-play-btn"
          aria-label={`Play ${video.title}`}
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 3 20 12 6 21"/></svg>
        </button>
        <span class="poster-duration">{video.duration}</span>
      </div>

      <div class="training-content">
        <span class="training-label">{video.subtitle}</span>
        <h3 class="training-title">{video.title}</h3>
        <p class="training-desc">{video.description}</p>

        <details class="chapters-accordion">
          <summary class="chapters-toggle">
            <span>Chapters</span>
            <svg class="chapters-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <ol class="chapters-list">
            {video.chapters.map((chapter) => (
              <li class="chapter-item">
                <span class="chapter-time">{chapter.time}</span>
                <span class="chapter-label">{chapter.label}</span>
              </li>
            ))}
          </ol>
        </details>

        <div class="training-ctas">
          <button type="button" class="btn btn--primary" id="training-cta-play">
            {video.ctaLabel}
          </button>
          {video.secondaryCta && secondaryHref && (
            <a href={secondaryHref} class="btn btn--secondary">
              {video.secondaryCta.label}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    max-width: var(--container-text);
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .training-card {
    max-width: 720px;
    margin-inline: auto;
    background: var(--surface);
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border-soft);
  }

  /* Always 16:9 — YouTube embed must not stretch with side content */
  .training-player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface-navy);
    overflow: hidden;
  }

  .training-poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .training-player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .play-btn {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    color: white;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .play-btn:hover,
  .play-btn:focus-visible {
    background: rgba(0, 0, 0, 0.5);
  }

  .play-btn svg {
    width: 56px;
    height: 56px;
    padding: 14px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  .poster-duration {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    z-index: 1;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: white;
    background: rgba(0, 0, 0, 0.6);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .training-player.is-playing .play-btn,
  .training-player.is-playing .poster-duration,
  .training-player.is-playing .training-poster-img {
    display: none;
  }

  .training-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .training-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--brand-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .training-title {
    font-size: var(--text-card);
    font-weight: var(--weight-bold);
    margin-bottom: 0;
  }

  .training-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
  }

  .chapters-accordion {
    margin-top: var(--space-2);
  }

  .chapters-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) 0;
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
    cursor: pointer;
    list-style: none;
  }

  .chapters-toggle::-webkit-details-marker {
    display: none;
  }

  .chapters-chevron {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  details[open] .chapters-chevron {
    transform: rotate(180deg);
  }

  .chapters-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-bottom: var(--space-2);
  }

  .chapter-item {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-1) 0;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .chapter-time {
    color: var(--text-muted);
    font-family: monospace;
    min-width: 36px;
    flex-shrink: 0;
  }

  .training-ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .training-ctas .btn {
    font-size: var(--text-label);
    min-height: 40px;
    padding: var(--space-2) var(--space-4);
  }
</style>

<script>
  const player = document.getElementById('training-player');
  if (player) {
    const embedSrc = player.getAttribute('data-embed-src');
    let started = false;

    function startTrainingVideo() {
      if (started || !embedSrc) return;
      started = true;

      const iframe = document.createElement('iframe');
      iframe.src = embedSrc;
      iframe.title = 'Khepia training video';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';

      player.classList.add('is-playing');
      player.appendChild(iframe);
    }

    document.getElementById('training-play-btn')?.addEventListener('click', startTrainingVideo);
    document.getElementById('training-cta-play')?.addEventListener('click', startTrainingVideo);
  }
</script>
