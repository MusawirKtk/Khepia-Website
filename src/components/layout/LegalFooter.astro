---
const footerSections = [
  {
    title: "Product",
    links: [
      { label: "How it works", href: "#how-it-works" },
      { label: "Send", href: "#sender" },
      { label: "Carry", href: "#carry" },
      { label: "Tracking", href: "#tracking" },
      { label: "Training", href: "#training" },
    ],
  },
  {
    title: "Trust & Safety",
    links: [
      { label: "Verification", href: "#verification" },
      { label: "Prohibited items", href: "/prohibited-items" },
      { label: "Customs", href: "/customs-and-liability" },
      { label: "Disputes", href: "#faq" },
      { label: "Payments and refunds", href: "/payments-refunds" },
    ],
  },
  {
    title: "Support",
    links: [
      { label: "WhatsApp", href: "https://wa.me/0000000000" },
      { label: "Email", href: "mailto:support@khepia.pk" },
      { label: "FAQ", href: "#faq" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Terms of Service", href: "/terms" },
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Sender Terms", href: "/sender-terms" },
      { label: "Passenger Terms", href: "/passenger-terms" },
      { label: "Payments & Refunds", href: "/payments-refunds" },
      { label: "Customs & Liability", href: "/customs-and-liability" },
      { label: "Account deletion", href: "/account-deletion" },
    ],
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer section section--deep">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Khepia home">
          <svg class="logo-mark" width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="currentColor" opacity="0.15"/>
            <path d="M8 24V8h4v6.5L17.5 8H22l-6.5 7.5L22 24h-4.5l-4-6.2L12 19v5H8z" fill="currentColor"/>
          </svg>
          <span class="footer-logo-text">Khepia</span>
        </a>
        <p class="footer-tagline">
          Send with someone already going.
        </p>
        <p class="footer-corridor">
          UAE · Saudi Arabia · Pakistan
        </p>
      </div>

      <!-- Link columns -->
      {footerSections.map((section) => (
        <div class="footer-column">
          <h4 class="footer-column-title">{section.title}</h4>
          <ul class="footer-links">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Security message -->
    <div class="footer-security">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <p>Khepia will never ask you to share your password, OTP, or verification code over WhatsApp, email, or phone.</p>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        © {currentYear} Khepia. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-16) var(--space-12);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr repeat(4, 1fr);
      gap: var(--space-12);
    }
  }

  /* ── Brand ────────────────────────────────────────── */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-on-dark);
    margin-bottom: var(--space-4);
  }

  .footer-logo-text {
    font-size: 1.125rem;
    font-weight: var(--weight-bold);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--text-on-dark-secondary);
    margin-bottom: var(--space-2);
  }

  .footer-corridor {
    font-size: var(--text-label);
    color: var(--text-on-dark-muted);
    letter-spacing: 0.04em;
  }

  /* ── Columns ──────────────────────────────────────── */
  .footer-column-title {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    color: var(--text-on-dark-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-4);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: var(--text-on-dark-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-link:hover {
    color: var(--text-on-dark);
  }

  /* ── Security message ─────────────────────────────── */
  .footer-security {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-12);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-on-dark);
  }

  .footer-security svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--text-on-dark-muted);
  }

  .footer-security p {
    font-size: var(--text-label);
    color: var(--text-on-dark-muted);
    line-height: var(--leading-normal);
  }

  /* ── Bottom ───────────────────────────────────────── */
  .footer-bottom {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-on-dark);
  }

  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
  }
</style>
