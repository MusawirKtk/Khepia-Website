---
import { trackingStates, demoParcel, demoMoney, formatPKR } from '../../data/demo';
---

<!-- Collection -->
<section class="collection section section--soft" id="collection">
  <div class="container">
    <div class="collection-inner reveal">
      <h2 class="section-title-center">Meet. Inspect. Confirm collection.</h2>
      <div class="collection-cards">
        <div class="collection-card">
          <h4 class="collection-role">Passenger responsibility</h4>
          <ul class="responsibility-list">
            <li>Inspect parcel</li>
            <li>Verify contents against declaration</li>
            <li>Do not accept an unopened parcel</li>
            <li>Confirm collection</li>
          </ul>
        </div>
        <div class="collection-status">
          <span class="status-from">Ready for collection</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          <span class="status-to">Collected</span>
          <span class="tracking-id">{demoParcel.trackingId}</span>
        </div>
        <div class="collection-card">
          <h4 class="collection-role">Sender responsibility</h4>
          <ul class="responsibility-list">
            <li>Hand over the documented parcel</li>
            <li>Confirm handover</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Flight / Travel -->
<section class="flight section section--navy" id="flight">
  <div class="container">
    <div class="flight-inner reveal">
      <h3 class="flight-title">The traveller was flying anyway.</h3>
      <p class="flight-sub">The parcel follows a journey that was already happening.</p>
      <div class="flight-route" aria-hidden="true">
        <span class="flight-city">Dubai</span>
        <div class="flight-line">
          <div class="flight-plane">✈</div>
        </div>
        <span class="flight-city">Pakistan</span>
      </div>
    </div>
  </div>
</section>

<!-- Tracking -->
<section class="tracking section section--white" id="tracking">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title-center">Follow every handover.</h2>
    </div>
    <div class="tracking-timeline reveal">
      {trackingStates.map((state) => (
        <div class={`tracking-step ${state.completed ? 'tracking-step--done' : ''}`}>
          <div class="tracking-dot-wrap">
            <div class={`tracking-dot ${state.completed ? 'tracking-dot--done' : ''}`}>
              {state.completed && (
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
              )}
            </div>
            <div class={`tracking-line ${state.completed ? 'tracking-line--done' : ''}`}></div>
          </div>
          <div class="tracking-content">
            <span class="tracking-label">{state.label}</span>
            <span class="tracking-who">{state.who}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Delivery Proof -->
<section class="delivery section section--white" id="delivery">
  <div class="container">
    <div class="delivery-inner reveal">
      <h3 class="section-title-center">Delivery needs proof, not just a tap.</h3>
      <div class="delivery-demo">
        <div class="delivery-card">
          <div class="delivery-field">
            <span class="delivery-label">Recipient</span>
            <span class="delivery-value">Fatima K.</span>
          </div>
          <div class="delivery-field">
            <span class="delivery-label">CNIC</span>
            <span class="delivery-value">•••••-•••••••-•</span>
          </div>
          <div class="delivery-upload">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            <span>Upload delivery proof</span>
          </div>
          <div class="delivery-btn">Mark delivered</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 24-hour Confirmation -->
<section class="confirmation section section--soft" id="confirmation">
  <div class="container">
    <div class="confirmation-inner reveal">
      <div class="confirmation-text">
        <h3 class="section-title-center">The sender gets to confirm.</h3>
        <p class="confirmation-desc">
          The sender can confirm delivery or open a dispute within the confirmation period. If no action is taken, the order follows Khepia's automatic completion rule.
        </p>
      </div>
      <div class="confirmation-demo">
        <div class="confirmation-card">
          <p class="confirmation-message">Passenger marked the parcel delivered.</p>
          <div class="confirmation-timer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6h4"/></svg>
            <span>~24 hours to respond</span>
          </div>
          <div class="confirmation-actions">
            <div class="confirm-btn confirm-btn--ok">Confirm delivery</div>
            <div class="confirm-btn confirm-btn--err">Open dispute</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Payout -->
<section class="payout section section--navy" id="payout">
  <div class="container">
    <div class="payout-inner reveal">
      <h3 class="payout-title">Transaction complete.</h3>
      <div class="payout-grid">
        <div class="payout-card">
          <span class="payout-label">Passenger</span>
          <div class="payout-row">
            <span>Deposit returned</span>
            <span class="payout-amount payout-amount--ok">{formatPKR(demoMoney.passengerDeposit)}</span>
          </div>
          <div class="payout-row">
            <span>Net carrying earning</span>
            <span class="payout-amount payout-amount--ok">{formatPKR(demoMoney.passengerNetEarning)}</span>
          </div>
          <div class="payout-divider"></div>
          <div class="payout-row">
            <span>Total released</span>
            <span class="payout-total">{formatPKR(demoMoney.passengerCompletionRelease)}</span>
          </div>
        </div>
        <div class="payout-card">
          <span class="payout-label">Khepia</span>
          <div class="payout-row">
            <span>Commission retained</span>
            <span class="payout-amount">{formatPKR(demoMoney.khepiaRetains)}</span>
          </div>
        </div>
        <div class="payout-card payout-card--sender">
          <span class="payout-label">Sender</span>
          <div class="payout-row">
            <span>Transaction</span>
            <span class="payout-complete">Complete ✓</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Ratings -->
<section class="ratings section section--white" id="ratings">
  <div class="container">
    <div class="ratings-inner reveal">
      <h3 class="section-title-center">Every completed trip builds the next person's trust.</h3>
      <div class="ratings-cards">
        <div class="rating-card">
          <span class="rating-role">Sender rates Passenger</span>
          <div class="stars">★★★★★</div>
        </div>
        <div class="rating-card">
          <span class="rating-role">Passenger rates Sender</span>
          <div class="stars">★★★★★</div>
        </div>
      </div>
      <p class="ratings-note">Example interface only</p>
    </div>
  </div>
</section>

<style>
  .section-title-center {
    font-size: var(--text-h2);
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  /* ── Collection ─────────────────────────────────────── */
  .collection-inner {
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  .collection-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 768px) {
    .collection-cards {
      grid-template-columns: 1fr auto 1fr;
      gap: var(--space-8);
    }
  }

  .collection-card {
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--border-soft);
  }

  .collection-role {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-3);
  }

  .responsibility-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .responsibility-list li {
    padding-left: var(--space-4);
    position: relative;
  }

  .responsibility-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  .collection-status {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .status-from {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .status-to {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--ok);
  }

  .tracking-id {
    font-family: monospace;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-2);
  }

  /* ── Flight ─────────────────────────────────────────── */
  .flight-inner {
    text-align: center;
    max-width: var(--container-text);
    margin-inline: auto;
  }

  .flight-title {
    font-size: var(--text-h2);
    color: var(--text-on-dark);
    margin-bottom: var(--space-3);
  }

  .flight-sub {
    font-size: var(--text-lg);
    color: var(--text-on-dark-secondary);
    margin-bottom: var(--space-10);
  }

  .flight-route {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
  }

  .flight-city {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    color: var(--text-on-dark);
  }

  .flight-line {
    position: relative;
    width: 200px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
  }

  .flight-plane {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.5rem;
  }

  @media (max-width: 639px) {
    .flight-line {
      width: 100px;
    }
  }

  /* ── Tracking Timeline ──────────────────────────────── */
  .tracking-timeline {
    display: flex;
    flex-direction: column;
    max-width: 560px;
    margin-inline: auto;
  }

  .tracking-step {
    display: flex;
    gap: var(--space-4);
  }

  .tracking-dot-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tracking-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--surface);
  }

  .tracking-dot--done {
    border-color: var(--ok);
    background: var(--ok);
  }

  .tracking-line {
    width: 2px;
    height: 32px;
    background: var(--border-soft);
  }

  .tracking-line--done {
    background: var(--ok);
  }

  .tracking-step:last-child .tracking-line {
    display: none;
  }

  .tracking-content {
    padding-top: var(--space-1);
    padding-bottom: var(--space-4);
  }

  .tracking-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .tracking-who {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .tracking-step--done .tracking-label {
    color: var(--ok);
  }

  /* ── Delivery ───────────────────────────────────────── */
  .delivery-inner {
    max-width: 480px;
    margin-inline: auto;
  }

  .delivery-demo {
    display: flex;
    justify-content: center;
  }

  .delivery-card {
    width: 320px;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    background: var(--surface-soft);
    border: 1px solid var(--border-soft);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .delivery-field {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
  }

  .delivery-label {
    color: var(--text-muted);
  }

  .delivery-value {
    font-weight: var(--weight-semibold);
  }

  .delivery-upload {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 2px dashed var(--border-medium);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .delivery-btn {
    padding: var(--space-3);
    text-align: center;
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    background: var(--brand-primary);
    color: white;
  }

  /* ── Confirmation ───────────────────────────────────── */
  .confirmation-inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .confirmation-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-8);
    max-width: 520px;
    margin-inline: auto;
  }

  .confirmation-card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-md);
    text-align: center;
  }

  .confirmation-message {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .confirmation-timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--warn);
    margin-bottom: var(--space-5);
  }

  .confirmation-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
  }

  .confirm-btn {
    flex: 1;
    max-width: 180px;
    padding: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .confirm-btn--ok {
    background: var(--ok);
    color: white;
  }

  .confirm-btn--err {
    background: transparent;
    border: 1px solid var(--err);
    color: var(--err);
  }

  /* ── Payout ─────────────────────────────────────────── */
  .payout-inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    text-align: center;
  }

  .payout-title {
    font-size: var(--text-h2);
    color: var(--text-on-dark);
    margin-bottom: var(--space-8);
  }

  .payout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .payout-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  .payout-card {
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
  }

  .payout-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-on-dark-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-4);
  }

  .payout-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--text-on-dark-secondary);
    padding: var(--space-1) 0;
  }

  .payout-amount {
    font-weight: var(--weight-medium);
    color: var(--text-on-dark);
  }

  .payout-amount--ok {
    color: #5CEBA0;
  }

  .payout-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: var(--space-2) 0;
  }

  .payout-total {
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    color: #5CEBA0;
  }

  .payout-complete {
    font-weight: var(--weight-bold);
    color: #5CEBA0;
  }

  /* ── Ratings ────────────────────────────────────────── */
  .ratings-inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .ratings-cards {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    flex-wrap: wrap;
  }

  .rating-card {
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface-soft);
    border: 1px solid var(--border-soft);
    text-align: center;
    min-width: 200px;
  }

  .rating-role {
    display: block;
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
  }

  .stars {
    font-size: 1.5rem;
    color: var(--warn);
    letter-spacing: 2px;
  }

  .ratings-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-4);
    font-style: italic;
  }
</style>
