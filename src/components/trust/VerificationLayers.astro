---
---

<section class="trust section section--white" id="verification">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title">Trust is built before the parcel changes hands.</h2>
    </div>

    <div class="trust-grid">
      <!-- Identity -->
      <div class="trust-card reveal">
        <div class="trust-card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="trust-card-title">Identity</h3>
        <ul class="trust-list">
          <li>CNIC verification</li>
          <li>CNIC images</li>
          <li>Overseas WhatsApp number</li>
          <li>Pakistan WhatsApp number</li>
          <li>OTP verification</li>
          <li>Email verification</li>
          <li>Manual account review</li>
        </ul>
      </div>

      <!-- Transaction evidence -->
      <div class="trust-card reveal" style="transition-delay: 100ms">
        <div class="trust-card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <h3 class="trust-card-title">Transaction evidence</h3>
        <ul class="trust-list">
          <li>Parcel photos</li>
          <li>Weight record</li>
          <li>Item declaration</li>
          <li>Recipient identity</li>
          <li>Declared value</li>
          <li>Tracking record</li>
          <li>Payment proof</li>
          <li>Delivery proof</li>
        </ul>
      </div>

      <!-- Privacy -->
      <div class="trust-card reveal" style="transition-delay: 200ms">
        <div class="trust-card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h3 class="trust-card-title">Privacy</h3>
        <div class="privacy-states">
          <div class="privacy-before">
            <span class="privacy-label">Before both sides commit</span>
            <ul class="trust-list">
              <li>Phone hidden</li>
              <li>Direct contact hidden</li>
              <li>Sensitive data protected</li>
            </ul>
          </div>
          <div class="privacy-after">
            <span class="privacy-label privacy-label--ok">After commitment verified</span>
            <ul class="trust-list trust-list--ok">
              <li>Contact details unlock</li>
              <li>Collection can be arranged</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Manual verification callout -->
    <div class="manual-callout reveal">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M20 8v6"/><path d="M23 11h-6"/></svg>
      <div>
        <h4 class="callout-title">Human checks where they matter.</h4>
        <p class="callout-desc">Account verification, payment proof, and exceptions are reviewed by the Khepia team — not only automated.</p>
      </div>
    </div>
  </div>
</section>

<!-- Contact unlock -->
<section class="unlock section section--soft" id="contact-unlock">
  <div class="container">
    <div class="unlock-inner reveal">
      <div class="unlock-text">
        <h3 class="unlock-title">Once both sides are committed, contact details unlock so collection can be arranged.</h3>
      </div>
      <div class="unlock-visual">
        <div class="unlock-card unlock-card--locked">
          <div class="unlock-card-header">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Locked
          </div>
          <div class="unlock-field blur-field">Ahmed K.</div>
          <div class="unlock-field blur-field">+971 •••• ••87</div>
          <div class="unlock-field blur-field">WhatsApp</div>
        </div>
        <svg class="unlock-arrow" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        <div class="unlock-card unlock-card--unlocked">
          <div class="unlock-card-header unlock-header--ok">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 5-5 5 5 0 0 1 5 5"/></svg>
            Unlocked
          </div>
          <div class="unlock-field">Ahmed K.</div>
          <div class="unlock-field">+971 55•• ••87</div>
          <div class="unlock-field unlock-field--wa">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
            Open WhatsApp
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    max-width: var(--container-text);
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: var(--text-h2);
  }

  /* ── Trust Grid ─────────────────────────────────────── */
  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .trust-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  .trust-card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface-soft);
    border: 1px solid var(--border-soft);
  }

  .trust-card-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--ink-50);
    color: var(--brand-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .trust-card-title {
    font-size: var(--text-card);
    margin-bottom: var(--space-4);
  }

  .trust-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .trust-list li {
    padding-left: var(--space-4);
    position: relative;
  }

  .trust-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  .trust-list--ok li::before {
    color: var(--ok);
  }

  .privacy-states {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .privacy-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .privacy-label--ok {
    color: var(--ok);
  }

  /* ── Manual Callout ─────────────────────────────────── */
  .manual-callout {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding: var(--space-5) var(--space-6);
    background: var(--surface-tint);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    max-width: 640px;
    margin-inline: auto;
  }

  .manual-callout svg {
    color: var(--brand-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .callout-title {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }

  .callout-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* ── Contact Unlock ─────────────────────────────────── */
  .unlock-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-8);
  }

  .unlock-title {
    font-size: var(--text-h3);
    max-width: 580px;
  }

  .unlock-visual {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    justify-content: center;
  }

  .unlock-card {
    width: 220px;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .unlock-card--locked {
    background: var(--surface);
    border: 1px solid var(--border-medium);
    opacity: 0.7;
  }

  .unlock-card--unlocked {
    background: var(--surface);
    border: 1px solid var(--ok);
    box-shadow: 0 0 0 3px var(--ok-soft);
  }

  .unlock-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  .unlock-header--ok {
    color: var(--ok);
  }

  .unlock-field {
    padding: var(--space-2) var(--space-3);
    background: var(--surface-soft);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .blur-field {
    filter: blur(4px);
    user-select: none;
    color: var(--text-muted);
  }

  .unlock-field--wa {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(31, 168, 85, 0.08);
    color: var(--wa);
    font-weight: var(--weight-semibold);
  }

  .unlock-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  @media (max-width: 639px) {
    .unlock-arrow {
      transform: rotate(90deg);
    }
  }
</style>
