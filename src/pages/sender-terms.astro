---
import LegalLayout from '../layouts/LegalLayout.astro';
---

<LegalLayout title="Sender Terms">
  <h1>Sender terms</h1>
  <p class="legal-notice">These terms are pending final legal review.</p>

  <section>
    <h2>Your obligations as a sender</h2>
    <ul>
      <li>Declare all parcel contents accurately and truthfully</li>
      <li>Provide correct parcel weight using a scale</li>
      <li>Send only permitted, non-dutiable items</li>
      <li>Pack and label parcels correctly</li>
      <li>Photograph the parcel unpacked, packed, labelled, and on a scale</li>
      <li>Provide accurate recipient information including CNIC</li>
      <li>Declare the goods value honestly</li>
      <li>Accept customs risk disclosures</li>
      <li>Complete payment through the approved Khepia flow</li>
      <li>Confirm delivery or open a dispute within the confirmation period</li>
    </ul>
  </section>

  <section>
    <h2>What you must not do</h2>
    <ul>
      <li>Include prohibited or restricted items</li>
      <li>Misrepresent parcel contents or value</li>
      <li>Arrange payment outside the Khepia platform</li>
      <li>Share personal data outside the platform</li>
    </ul>
  </section>

  <section>
    <h2>Training</h2>
    <p>All senders should complete the <a href="/#training">Sender Training</a> before creating their first parcel.</p>
  </section>
</LegalLayout>
